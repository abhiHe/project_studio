# ── Firebase ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# ── Firestore Emulator (local Linux development) ──────────────────────
# Set USE_EMULATOR=true and FIRESTORE_EMULATOR_HOST when developing locally.
# The Firebase Admin SDK auto-routes all Firestore traffic to the emulator
# when FIRESTORE_EMULATOR_HOST is set — no service account key required.
# Start the emulator with: bash scripts/start-emulator.sh
# Or copy .env.emulator to .env for a ready-made emulator config.
USE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── MySQL (legacy / hybrid use) ────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=kwcommon

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@krimewatch.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=KrimeWatch <noreply@krimewatch.com>

# ── Google Cloud Storage ──────────────────────────────────────────────
GCS_BUCKET=your-gcs-bucket-name

# ── App ───────────────────────────────────────────────────────────────
PORT=3000
APP_URL=https://your-app-domain.com
API_ROOT=https://api.your-domain.com
KW_LOGO=assets/logo.png

#