# ── .env.emulator ─────────────────────────────────────────────────────
# Ready-to-use environment for local Linux Firestore emulator.
# Usage:  cp .env.emulator .env   then   npm run emulator  (in one terminal)
#         npm run dev:emulator            (in another terminal)
# ─────────────────────────────────────────────────────────────────────

# ── Firebase (Emulator) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=krimewatch-emulator
USE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=emulator_dev_secret_change_in_prod
JWT_EXPIRES_IN=7d

# ── Email (SMTP — use Ethereal or Mailhog for local testing) ──────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=dev@ethereal.email
SMTP_PASS=dev_password
EMAIL_FROM=KrimeWatch Dev <dev@krimewatch.com>

# ── Google Cloud Storage (point to local emulator or skip) ────────────
GCS_BUCKET=krimewatch-dev-bucket

# ── App ───────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
API_ROOT=http://localhost:3000
KW_LOGO=assets/logo.png

# ── Encryption (dev values — 32 chars key, 16 chars IV) ───────────────
ENCRYPT_KEY=devkey1234567890devkey1234567890
ENCRYPT_IV=deviv12345678901

# ── PayU (dev/sandbox) ────────────────────────────────────────────────
PAYU_MERCHANT_KEY=gtKFFx
PAYU_SALT=eCwWELxi
PAYU_SUCCESS_URL=http://localhost:3000/payment-successful
PAYU_FAIL_URL=http://localhost:3000/payment-failed

# ── MySQL (not required in emulator mode — Firestore only) ────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=kwcommon
